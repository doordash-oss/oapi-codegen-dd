// clientContractRequest is what the contract server observed.
type clientContractRequest struct {
    method string
    path   string
    query  url.Values
    header http.Header
    body   []byte
}

// newClientContractServer replies to every request with the given status,
// content type and body, recording the request it received.
func newClientContractServer(t *testing.T, got *clientContractRequest, status int, contentType, body string) *httptest.Server {
    t.Helper()
    srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
        reqBody, _ := io.ReadAll(r.Body)
        *got = clientContractRequest{
            method: r.Method,
            path:   r.URL.Path,
            query:  r.URL.Query(),
            header: r.Header.Clone(),
            body:   reqBody,
        }
        if contentType != "" {
            w.Header().Set("Content-Type", contentType)
        }
        w.WriteHeader(status)
        _, _ = io.WriteString(w, body)
    }))
    t.Cleanup(srv.Close)
    return srv
}

func newClientContractClient(t *testing.T, srv *httptest.Server) *{{ $clientName }} {
    t.Helper()
    client, err := NewDefault{{ $clientName }}(srv.URL, runtime.WithStdHTTPClient(srv.Client()))
    if err != nil {
        t.Fatalf("creating client: %v", err)
    }
    return client
}

// decodeClientContractFixture decodes a spec-derived fixture into target.
// A failure means the generated type cannot hold a value its schema allows.
func decodeClientContractFixture(t *testing.T, what, fixture string, target any) {
    t.Helper()
    if err := json.Unmarshal([]byte(fixture), target); err != nil {
        t.Fatalf("%s fixture %s does not decode into %T: %v", what, fixture, target, err)
    }
}

// assertClientContractJSON compares two values by their JSON encoding.
func assertClientContractJSON(t *testing.T, what string, want, got any) {
    t.Helper()
    wantJSON, err := json.Marshal(want)
    if err != nil {
        t.Fatalf("encoding expected %s: %v", what, err)
    }
    gotJSON, err := json.Marshal(got)
    if err != nil {
        t.Fatalf("encoding actual %s: %v", what, err)
    }
    if !bytes.Equal(wantJSON, gotJSON) {
        t.Errorf("%s mismatch:\nwant %s\ngot  %s", what, wantJSON, gotJSON)
    }
}

// assertClientContractPath checks the literal segments of a path template,
// for paths whose parameters have no single expected encoding.
func assertClientContractPath(t *testing.T, template, got string) {
    t.Helper()
    want := strings.Split(strings.TrimSuffix(template, "/"), "/")
    have := strings.Split(got, "/")
    if len(want) != len(have) {
        t.Errorf("path = %q, want it to match %q", got, template)
        return
    }
    for i, seg := range want {
        if strings.HasPrefix(seg, "{") && strings.HasSuffix(seg, "}") {
            if have[i] == "" {
                t.Errorf("path = %q: parameter %s is empty", got, seg)
            }
            continue
        }
        if seg != have[i] {
            t.Errorf("path = %q, want it to match %q", got, template)
            return
        }
    }
}

func assertClientContractMediaType(t *testing.T, what, header, want string) {
    t.Helper()
    got, _, err := mime.ParseMediaType(header)
    if err != nil || !strings.EqualFold(got, want) {
        t.Errorf("%s Content-Type = %q, want %q", what, header, want)
    }
}

