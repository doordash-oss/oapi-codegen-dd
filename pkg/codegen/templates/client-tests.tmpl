{{- $optsName := printf "%sRequestOptions" ($op.ID | ucFirst) }}
func Test{{ $clientName }}Contract_{{ $op.ID | ucFirst }}(t *testing.T) {
    {{- if $op.HasRequestOptions }}
    newOptions := func(t *testing.T) *{{ $optsName }} {
        t.Helper()
        opts := &{{ $optsName }}{}
        {{- if $op.PathParams }}
        opts.PathParams = new({{ $op.PathParams.Name }})
        decodeClientContractFixture(t, "path params", {{ fixtureLiteral $tc.PathParamsJSON }}, opts.PathParams)
        {{- end }}
        {{- if $op.Query }}
        opts.Query = new({{ $op.Query.Name }})
        decodeClientContractFixture(t, "query", {{ fixtureLiteral $tc.QueryJSON }}, opts.Query)
        {{- end }}
        {{- if $op.Header }}
        opts.Header = new({{ $op.Header.Name }})
        decodeClientContractFixture(t, "header", {{ fixtureLiteral $tc.HeaderJSON }}, opts.Header)
        {{- end }}
        {{- if and $op.Body $tc.BodyIsJSON }}
        opts.Body = new({{ $op.Body.Name }})
        decodeClientContractFixture(t, "body", {{ fixtureLiteral $tc.BodyJSON }}, opts.Body)
        {{- end }}
        return opts
    }
    {{- end }}

    t.Run("success", func(t *testing.T) {
        var got clientContractRequest
        srv := newClientContractServer(t, &got, {{ $tc.SuccessStatus }}, {{ fixtureLiteral $tc.SuccessMediaType }}, {{ fixtureLiteral $tc.SuccessJSON }})
        client := newClientContractClient(t, srv)
        {{- if $op.HasRequestOptions }}
        opts := newOptions(t)
        res, err := client.{{ $op.ID }}(context.Background(), opts)
        {{- else }}
        res, err := client.{{ $op.ID }}(context.Background())
        {{- end }}
        if err != nil {
            t.Fatalf("{{ $op.ID }}: %v", err)
        }

        if got.method != {{ fixtureLiteral $op.Method }} {
            t.Errorf("method = %q, want %q", got.method, {{ fixtureLiteral $op.Method }})
        }
        {{- if $tc.ExpectedPath }}
        if want := {{ fixtureLiteral $tc.ExpectedPath }}; got.path != want {
            t.Errorf("path = %q, want %q", got.path, want)
        }
        {{- else }}
        assertClientContractPath(t, {{ fixtureLiteral $tc.PathPattern }}, got.path)
        {{- end }}
        {{- range $tc.QueryValues }}
        if v := got.query.Get({{ fixtureLiteral .Key }}); v != {{ fixtureLiteral .Value }} {
            t.Errorf("query %s = %q, want %q", {{ fixtureLiteral .Key }}, v, {{ fixtureLiteral .Value }})
        }
        {{- end }}
        {{- range $tc.QueryKeys }}
        if !func() bool {
            for k := range got.query {
                if k == {{ fixtureLiteral . }} || strings.HasPrefix(k, {{ fixtureLiteral . }}+"[") {
                    return true
                }
            }
            return false
        }() {
            t.Errorf("query parameter %s missing from %q", {{ fixtureLiteral . }}, got.query.Encode())
        }
        {{- end }}
        {{- range $tc.Headers }}
        if v := got.header.Get({{ fixtureLiteral .Key }}); v != {{ fixtureLiteral .Value }} {
            t.Errorf("header %s = %q, want %q", {{ fixtureLiteral .Key }}, v, {{ fixtureLiteral .Value }})
        }
        {{- end }}
        {{- if $op.Body }}
        {{- if $tc.BodyIsJSON }}
        assertClientContractMediaType(t, "request", got.header.Get("Content-Type"), {{ fixtureLiteral $tc.BodyMediaType }})
        sent := new({{ $op.Body.Name }})
        if err := json.Unmarshal(got.body, sent); err != nil {
            t.Fatalf("request body %s does not decode into %T: %v", got.body, sent, err)
        }
        assertClientContractJSON(t, "request body", opts.Body, sent)
        {{- end }}
        {{- end }}

        {{- if eq $tc.SuccessDecode "json" }}
        want := new({{ $op.Response.Success.ResponseName }})
        decodeClientContractFixture(t, "response", {{ fixtureLiteral $tc.SuccessJSON }}, want)
        if res == nil {
            t.Fatal("{{ $op.ID }} returned a nil response")
        }
        assertClientContractJSON(t, "response", want, res)
        {{- else if eq $tc.SuccessDecode "raw" }}
        if res == nil || string(*res) != {{ fixtureLiteral $tc.SuccessJSON }} {
            t.Errorf("raw response = %v, want %q", res, {{ fixtureLiteral $tc.SuccessJSON }})
        }
        {{- else }}
        _ = res
        {{- end }}
    })
    {{- if $tc.ErrorStatus }}

    t.Run("error {{ $tc.ErrorStatus }}", func(t *testing.T) {
        var got clientContractRequest
        srv := newClientContractServer(t, &got, {{ $tc.ErrorStatus }}, {{ fixtureLiteral $tc.ErrorMediaType }}, {{ fixtureLiteral $tc.ErrorJSON }})
        client := newClientContractClient(t, srv)
        {{- if $op.HasRequestOptions }}
        _, err := client.{{ $op.ID }}(context.Background(), newOptions(t))
        {{- else }}
        _, err := client.{{ $op.ID }}(context.Background())
        {{- end }}
        var apiErr *runtime.ClientAPIError
        if !errors.As(err, &apiErr) {
            t.Fatalf("err = %v, want a *runtime.ClientAPIError", err)
        }
        if apiErr.StatusCode() != {{ $tc.ErrorStatus }} {
            t.Errorf("status = %d, want {{ $tc.ErrorStatus }}", apiErr.StatusCode())
        }
    })
    {{- end }}
}
