{{/* Chi-specific template blocks */}}

{{define "router-import"}}"github.com/go-chi/chi/v5"{{end}}

{{define "get-path-param"}}chi.URLParam(r, "{{ . }}"){{end}}

{{define "new-router"}}
{{- $config := .Config -}}
{{- $operations := .Operations -}}
{{- $handlerName := $config.Generate.Handler.Name -}}
// NewRouter creates a new chi.Router with the given handler implementation.
func NewRouter(impl {{ $handlerName }}Interface, opts ...RouterOption) chi.Router {
    cfg := &routerConfig{}
    for _, opt := range opts {
        opt(cfg)
    }

    adapter := NewHTTPAdapter(impl)

    r := chi.NewRouter()
    for _, mw := range cfg.middlewares {
        r.Use(mw)
    }

    {{- range $operations }}{{ $op := . }}
        r.Method("{{ $op.Method }}", "{{ $op.Path }}", http.HandlerFunc(adapter.{{ $op.ID | ucFirst }}))
    {{- end }}

    return r
}
{{end}}

{{template "handler/shared/handler.tmpl" .}}
{{template "handler/shared/adapter.tmpl" .}}
{{template "handler/shared/router.tmpl" .}}
