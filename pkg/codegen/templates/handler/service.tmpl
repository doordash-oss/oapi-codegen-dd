{{- $config := .Config -}}
{{- $operations := .Operations -}}
{{- $serviceName := $config.Generate.Handler.Name -}}
{{- $receiver := $serviceName | fst | lower -}}
{{- $packageName := .PackageName -}}
{{- /* Handler prefix: handler-owned symbols (ServiceInterface, XServiceRequestOptions,
       XResponseData) need this when the handler is generated into its own package,
       seen here via generate.handler.handler-package-alias. Model body types below go
       through modelType instead - see generate.handler.models-package. */ -}}
{{- $handlerAlias := $config.Generate.Handler.HandlerPackageAlias -}}
{{- $handlerPrefix := "" -}}
{{- if $handlerAlias -}}
{{- $handlerPrefix = printf "%s." $handlerAlias -}}
{{- end -}}
// Package {{ $packageName }} This file is generated ONCE as a starting point and will NOT be overwritten.
// Modify it freely to add your business logic.
// To regenerate, delete this file or set generate.handler.output.overwrite: true in config.
package {{ $packageName }}

import (
	"context"
	{{- range $config.AdditionalImports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Package}}"
	{{- end}}
)

// {{ $serviceName }} implements the {{ $serviceName }}Interface.
// Add your dependencies here (database, clients, etc.)
type {{ $serviceName }} struct {
}

// New{{ $serviceName }} creates a new {{ $serviceName }}.
func New{{ $serviceName }}() *{{ $serviceName }} {
	return &{{ $serviceName }}{}
}

// Ensure {{ $serviceName }} implements {{ $handlerPrefix }}{{ $serviceName }}Interface.
var _ {{ $handlerPrefix }}{{ $serviceName }}Interface = (*{{ $serviceName }})(nil)

{{- range $operations }}{{ $op := . }}

// {{ $op.ID }} handles {{ $op.Method }} {{ $op.Path }}
{{- if and (not $config.Generate.OmitDescription) $op.Summary }}
{{ toGoComment $op.Summary "" }}
{{- end }}
{{- if $op.HasRequestOptions }}
func ({{ $receiver }} *{{ $serviceName }}) {{ $op.ID }}(ctx context.Context, opts *{{ $handlerPrefix }}{{ $op.ID | ucFirst }}ServiceRequestOptions) ({{ if $op.Response.Success }}*{{ $handlerPrefix }}{{ $op.ID | ucFirst }}ResponseData, error{{ else }}error{{ end }}) {
	// TODO: Implement your business logic here
	{{- if $op.Response.Success }}
	{{- if $op.Response.Success.IsRaw }}
	return {{ $handlerPrefix }}New{{ $op.ID | ucFirst }}ResponseData([]byte("TODO: marshal response")), nil
	{{- else }}
	{{- $bodyType := modelType $op.Response.Success.ResponseName -}}
	{{- if eq $bodyType "struct{}" }}
	return {{ $handlerPrefix }}New{{ $op.ID | ucFirst }}ResponseData(nil), nil
	{{- else }}
	{{- if and (not $config.Generate.Handler.ModelsPackage) $handlerPrefix }}{{ $bodyType = printf "%s%s" $handlerPrefix $bodyType }}{{ end }}
	return {{ $handlerPrefix }}New{{ $op.ID | ucFirst }}ResponseData(new({{ $bodyType }})), nil
	{{- end }}
	{{- end }}
	{{- else }}
	return nil
	{{- end }}
}
{{- else }}
func ({{ $receiver }} *{{ $serviceName }}) {{ $op.ID }}(ctx context.Context) ({{ if $op.Response.Success }}*{{ $handlerPrefix }}{{ $op.ID | ucFirst }}ResponseData, error{{ else }}error{{ end }}) {
	// TODO: Implement your business logic here
	{{- if $op.Response.Success }}
	{{- if $op.Response.Success.IsRaw }}
	return {{ $handlerPrefix }}New{{ $op.ID | ucFirst }}ResponseData([]byte("TODO: marshal response")), nil
	{{- else }}
	{{- $bodyType := modelType $op.Response.Success.ResponseName -}}
	{{- if eq $bodyType "struct{}" }}
	return {{ $handlerPrefix }}New{{ $op.ID | ucFirst }}ResponseData(nil), nil
	{{- else }}
	{{- if and (not $config.Generate.Handler.ModelsPackage) $handlerPrefix }}{{ $bodyType = printf "%s%s" $handlerPrefix $bodyType }}{{ end }}
	return {{ $handlerPrefix }}New{{ $op.ID | ucFirst }}ResponseData(new({{ $bodyType }})), nil
	{{- end }}
	{{- end }}
	{{- else }}
	return nil
	{{- end }}
}
{{- end }}
{{- end }}
